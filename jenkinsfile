pipeline {
    agent any
    environment {
        // These should be bound to Jenkins credentials securely
        KAGGLE_USERNAME = credentials('kaggle-username')
        KAGGLE_KEY = credentials('kaggle-key')
    }
    stages {
        stage('Clone Code') {
            steps {
                git 'https://github.com/username/etl-project.git'
            }
        }
        stage('Install Libraries') {
            steps {
                bat 'pip install -r requirement.txt'
            }
        }
        stage('Collect Data') {
            steps {
                bat 'python src\\collect\\collect_data.py'
            }
        }
        stage('Transform Data') {
            steps {
                bat 'python src\\transform\\tranform_data.py'
            }
        }
        stage('Ingest Data') {
            steps {
                bat 'python ingest_data.py'
            }
        }
    }
}
